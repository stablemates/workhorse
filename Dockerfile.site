FROM golang:1.25.14-alpine AS go
FROM ghcr.io/astral-sh/uv:0.8.9 AS uv
FROM node:24-alpine AS build

ENV PNPM_HOME=/pnpm
ENV PATH=/usr/local/go/bin:$PNPM_HOME:$PATH

COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /uvx /bin/

RUN apk add --no-cache python3 \
    && corepack enable \
    && corepack prepare pnpm@10.18.3 --activate

WORKDIR /workhorse
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:core && pnpm docs:build

FROM nginx:1.29-alpine AS runtime

COPY deployment/site.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workhorse/site/dist/client/ /usr/share/nginx/html/

EXPOSE 8080
