FROM golang:1.25.14-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS go
FROM ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc AS uv
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build

ENV PNPM_HOME=/pnpm
ENV PATH=/usr/local/go/bin:$PNPM_HOME:$PATH

COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /uvx /bin/

RUN apk add --no-cache python3 \
    && corepack enable \
    && corepack prepare pnpm@10.18.3 --activate

ARG BUILD_CONCURRENCY=4
ENV GOMAXPROCS=${BUILD_CONCURRENCY}
ENV PNPM_CONFIG_NETWORK_CONCURRENCY=${BUILD_CONCURRENCY}
ENV PNPM_CONFIG_MAX_SOCKETS=${BUILD_CONCURRENCY}
ENV UV_CONCURRENT_DOWNLOADS=${BUILD_CONCURRENCY}
ENV UV_CONCURRENT_INSTALLS=${BUILD_CONCURRENCY}

# V8 sizes every heap at 4288 MB whatever the host has, so the site build here can promise more
# memory than the machine building the image owns. Only this stage sets it, and the runtime stage
# is nginx, so nothing reaches the published image.
ENV NODE_OPTIONS=--max-old-space-size=2048

WORKDIR /workhorse
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:core && pnpm docs:build

# nginx-unprivileged is the nginx image with its master process moved off root: it runs as UID 101,
# listens on 8080 rather than 80, and keeps its pid and temporary paths under /tmp. The site serves
# static files and terminates no TLS, so the master needs no privileged port and no root. The
# configuration below is the same file the root image took.
FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 AS runtime

COPY site/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workhorse/site/dist/client/ /usr/share/nginx/html/

USER 101
EXPOSE 8080
