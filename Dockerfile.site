FROM golang:1.25.14-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS go
FROM ghcr.io/astral-sh/uv:0.8.9@sha256:cda9608307dbbfc1769f3b6b1f9abf5f1360de0be720f544d29a7ae2863c47ef AS uv
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS build

ENV PNPM_HOME=/pnpm
ENV PATH=/usr/local/go/bin:$PNPM_HOME:$PATH

COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /uvx /bin/

RUN apk add --no-cache python3 \
    && corepack enable \
    && corepack prepare pnpm@10.18.3 --activate

WORKDIR /workhorse
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:core && pnpm docs:build

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS runtime

COPY site/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workhorse/site/dist/client/ /usr/share/nginx/html/

EXPOSE 8080
