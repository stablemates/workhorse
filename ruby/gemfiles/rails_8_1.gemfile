# frozen_string_literal: true

# The development bundle against Rails 8.1, the Active Job floor. CI selects it with BUNDLE_GEMFILE.
@rails_declared = true
eval_gemfile File.expand_path("../Gemfile", __dir__)

group :development do
  %w[actionpack activejob activerecord railties].each { |name| gem name, "~> 8.1.0" }
end
