{
  "name": "workhorse-operations",
  "title": "Workhorse Operations",
  "description": "Queue flow, backlog pressure, and worker capacity for the Workhorse demo.",
  "tags": {
    "component": "workhorse",
    "view": "operations"
  },
  "panels": [
    {
      "id": "queue-flow",
      "title": "Queue flow",
      "description": "Tasks accepted and claimed per second, split by queue.",
      "unit": "ops/s",
      "queries": [
        {
          "metric": "workhorse.tasks.enqueued",
          "timeAggregation": "rate",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.queue.name"],
          "legend": "enqueued {{workhorse.queue.name}}"
        },
        {
          "metric": "workhorse.tasks.claimed",
          "timeAggregation": "rate",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.queue.name"],
          "legend": "claimed {{workhorse.queue.name}}"
        }
      ]
    },
    {
      "id": "execution-throughput",
      "title": "Execution throughput",
      "description": "Handler executions per second, split by durable outcome.",
      "unit": "ops/s",
      "queries": [
        {
          "metric": "workhorse.handler.executions",
          "timeAggregation": "rate",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.handler.outcome"],
          "legend": "{{workhorse.handler.outcome}}"
        }
      ]
    },
    {
      "id": "live-tasks",
      "title": "Live tasks",
      "description": "Current scheduled, ready, and active tasks by queue.",
      "unit": "{task}",
      "queries": [
        {
          "metric": "workhorse.tasks.count",
          "timeAggregation": "latest",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.queue.name", "workhorse.task.state"],
          "legend": "{{workhorse.queue.name}} {{workhorse.task.state}}"
        }
      ]
    },
    {
      "id": "oldest-ready-age",
      "title": "Oldest ready task",
      "description": "Age of the oldest ready task in each queue.",
      "unit": "s",
      "queries": [
        {
          "metric": "workhorse.queue.oldest_ready.age",
          "timeAggregation": "latest",
          "spaceAggregation": "max",
          "groupBy": ["workhorse.queue.name"],
          "legend": "{{workhorse.queue.name}}"
        }
      ]
    },
    {
      "id": "worker-slots",
      "title": "Worker slots",
      "description": "Declared capacity and occupied slots by queue.",
      "unit": "{slot}",
      "queries": [
        {
          "metric": "workhorse.worker.capacity",
          "timeAggregation": "latest",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.queue.name"],
          "legend": "capacity {{workhorse.queue.name}}"
        },
        {
          "metric": "workhorse.worker.active",
          "timeAggregation": "latest",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.queue.name"],
          "legend": "active {{workhorse.queue.name}}"
        }
      ]
    },
    {
      "id": "worker-fleet",
      "title": "Worker fleet",
      "description": "Registered workers by queue and runtime state.",
      "unit": "{worker}",
      "queries": [
        {
          "metric": "workhorse.worker.count",
          "timeAggregation": "latest",
          "spaceAggregation": "sum",
          "groupBy": ["workhorse.queue.name", "workhorse.worker.state"],
          "legend": "{{workhorse.queue.name}} {{workhorse.worker.state}}"
        }
      ]
    },
    {
      "id": "paused-queues",
      "title": "Paused queues",
      "description": "Queue dispatch pause state, where one means paused.",
      "unit": "1",
      "queries": [
        {
          "metric": "workhorse.queue.paused",
          "timeAggregation": "latest",
          "spaceAggregation": "max",
          "groupBy": ["workhorse.queue.name"],
          "legend": "{{workhorse.queue.name}}"
        }
      ]
    }
  ]
}
