[
  {
    "id": "object-validation",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["recipient"],
      "properties": { "recipient": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "instances": [
      { "value": { "recipient": "person@example.test" }, "valid": true },
      { "value": { "recipient": "" }, "valid": false },
      { "value": { "recipient": "ok", "extra": true }, "valid": false }
    ]
  },
  {
    "id": "bundled-reference",
    "schema": {
      "$defs": { "identifier": { "type": "integer", "minimum": 1 } },
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "minItems": 1
    },
    "instances": [
      { "value": [1, 2], "valid": true },
      { "value": [0], "valid": false }
    ]
  },
  {
    "id": "format-is-annotation",
    "schema": { "type": "string", "format": "email" },
    "instances": [{ "value": "deliberately not an email", "valid": true }]
  },
  {
    "id": "union-type",
    "schema": { "type": ["string", "number"] },
    "instances": [
      { "value": "text", "valid": true },
      { "value": 1.5, "valid": true },
      { "value": true, "valid": false }
    ]
  },
  {
    "id": "properties-without-object-type",
    "schema": { "properties": { "count": { "type": "integer" } } },
    "instances": [
      { "value": { "count": 1 }, "valid": true },
      { "value": "not an object", "valid": true },
      { "value": { "count": "one" }, "valid": false }
    ]
  },
  {
    "id": "prefix-items-without-tuple-bounds",
    "schema": { "type": "array", "prefixItems": [{ "type": "string" }] },
    "instances": [
      { "value": [], "valid": true },
      { "value": ["first", 2], "valid": true },
      { "value": [1], "valid": false }
    ]
  },
  {
    "id": "required-without-properties",
    "schema": { "type": "object", "required": ["id"] },
    "instances": [
      { "value": { "id": 1 }, "valid": true },
      { "value": {}, "valid": false }
    ]
  },
  {
    "id": "dependent-keywords-without-their-anchor",
    "schema": { "type": "array", "minContains": 2, "then": false },
    "instances": [
      { "value": [], "valid": true },
      { "value": "not an array", "valid": false }
    ]
  },
  {
    "id": "remote-reference-rejected",
    "schema": { "$ref": "https://example.com/external.json" },
    "schemaError": true
  },
  {
    "id": "dynamic-reference-rejected",
    "schema": { "$dynamicRef": "#node" },
    "schemaError": true
  },
  {
    "id": "unevaluated-properties-rejected",
    "schema": { "type": "object", "unevaluatedProperties": false },
    "schemaError": true
  },
  {
    "id": "custom-keyword-rejected",
    "schema": { "type": "string", "workhorseCustom": true },
    "schemaError": true
  },
  {
    "id": "pattern-rejected",
    "schema": { "type": "string", "pattern": "^a$" },
    "schemaError": true
  },
  {
    "id": "pattern-properties-rejected",
    "schema": { "type": "object", "patternProperties": { "^a": { "type": "string" } } },
    "schemaError": true
  },
  {
    "id": "pattern-in-defs-rejected",
    "schema": {
      "$defs": { "code": { "type": "string", "pattern": "^a$" } },
      "$ref": "#/$defs/code"
    },
    "schemaError": true
  },
  {
    "id": "pattern-in-items-rejected",
    "schema": { "type": "array", "items": { "type": "string", "pattern": "^a$" } },
    "schemaError": true
  },
  {
    "id": "pattern-in-properties-rejected",
    "schema": {
      "type": "object",
      "properties": { "code": { "type": "string", "pattern": "^a$" } }
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-in-defs-rejected",
    "schema": {
      "$defs": { "codes": { "type": "object", "patternProperties": { "^a": true } } },
      "$ref": "#/$defs/codes"
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-in-items-rejected",
    "schema": {
      "type": "array",
      "items": { "type": "object", "patternProperties": { "^a": true } }
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-in-properties-rejected",
    "schema": {
      "type": "object",
      "properties": { "codes": { "type": "object", "patternProperties": { "^a": true } } }
    },
    "schemaError": true
  },
  {
    "id": "properties-named-after-pattern-keywords",
    "schema": {
      "type": "object",
      "required": ["pattern"],
      "properties": { "pattern": { "type": "string" }, "patternProperties": { "type": "integer" } }
    },
    "instances": [
      { "value": { "pattern": "^a$", "patternProperties": 1 }, "valid": true },
      { "value": { "pattern": 1 }, "valid": false },
      { "value": {}, "valid": false }
    ]
  },
  {
    "id": "pattern-behind-reference-rejected",
    "schema": { "default": { "type": "string", "pattern": "^a$" }, "$ref": "#/default" },
    "schemaError": true
  },
  {
    "id": "pattern-properties-behind-reference-rejected",
    "schema": {
      "examples": [{ "type": "object", "patternProperties": { "^a": true } }],
      "$ref": "#/examples/0"
    },
    "schemaError": true
  },
  {
    "id": "reference-outside-schema-rejected",
    "schema": { "default": { "type": "string" }, "$ref": "#/default" },
    "schemaError": true
  },
  {
    "id": "unresolved-reference-rejected",
    "schema": { "$ref": "#/$defs/missing" },
    "schemaError": true
  },
  {
    "id": "reference-to-property-rejected",
    "schema": {
      "properties": { "a": { "type": "integer" }, "b": { "$ref": "#/properties/a" } }
    },
    "schemaError": true
  },
  {
    "id": "reference-to-items-rejected",
    "schema": {
      "type": "array",
      "items": { "type": "integer" },
      "contains": { "$ref": "#/items" }
    },
    "schemaError": true
  },
  {
    "id": "reference-to-all-of-entry-rejected",
    "schema": {
      "allOf": [{ "type": "integer" }],
      "properties": { "a": { "$ref": "#/allOf/0" } }
    },
    "schemaError": true
  },
  {
    "id": "reference-inside-definition-rejected",
    "schema": {
      "$defs": { "a": { "properties": { "b": { "type": "integer" } } } },
      "properties": { "c": { "$ref": "#/$defs/a/properties/b" } }
    },
    "schemaError": true
  },
  {
    "id": "percent-encoded-definition-reference-rejected",
    "schema": { "$defs": { "a": { "type": "integer" } }, "$ref": "#/$defs/%61" },
    "schemaError": true
  },
  {
    "id": "percent-encoded-space-reference-rejected",
    "schema": { "$defs": { "a b": { "type": "integer" } }, "$ref": "#/$defs/a%20b" },
    "schemaError": true
  },
  {
    "id": "escaped-slash-reference-rejected",
    "schema": { "$defs": { "a/b": { "type": "integer" } }, "$ref": "#/$defs/a~1b" },
    "schemaError": true
  },
  {
    "id": "anchor-reference-rejected",
    "schema": {
      "$defs": { "a": { "$anchor": "name", "type": "integer" } },
      "properties": { "b": { "$ref": "#name" } }
    },
    "schemaError": true
  },
  {
    "id": "root-anchor-rejected",
    "schema": { "$anchor": "root", "type": "integer" },
    "schemaError": true
  },
  {
    "id": "nested-anchor-rejected",
    "schema": { "properties": { "a": { "$anchor": "a", "type": "integer" } } },
    "schemaError": true
  },
  {
    "id": "definition-name-outside-grammar-rejected",
    "schema": { "$defs": { "1a": { "type": "integer" } }, "$ref": "#/$defs/1a" },
    "schemaError": true
  },
  {
    "id": "definitions-below-root-rejected",
    "schema": { "properties": { "a": { "$defs": { "b": { "type": "integer" } } } } },
    "schemaError": true
  },
  {
    "id": "references-to-root-and-definitions",
    "schema": {
      "$defs": {
        "__schema0": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "node.v1": {
          "type": "object",
          "properties": { "next": { "$ref": "#/$defs/node.v1" } },
          "additionalProperties": false
        }
      },
      "type": "object",
      "required": ["$anchor"],
      "properties": {
        "$anchor": { "$ref": "#/$defs/__schema0" },
        "count": { "$ref": "#/$defs/count" },
        "chain": { "$ref": "#/$defs/node.v1" },
        "self": { "$ref": "#" }
      },
      "additionalProperties": false
    },
    "instances": [
      {
        "value": {
          "$anchor": "a",
          "count": 1,
          "chain": { "next": { "next": {} } },
          "self": { "$anchor": "b" }
        },
        "valid": true
      },
      { "value": { "$anchor": 1 }, "valid": false },
      { "value": { "$anchor": "a", "count": -1 }, "valid": false },
      { "value": { "$anchor": "a", "chain": { "next": { "other": 1 } } }, "valid": false },
      { "value": { "$anchor": "a", "self": {} }, "valid": false },
      { "value": {}, "valid": false }
    ]
  }
]
