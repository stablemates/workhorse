        "valid": true
      },
      { "value": { "$anchor": 1 }, "valid": false },
      { "value": { "$anchor": "a", "count": -1 }, "valid": false },
      { "value": { "$anchor": "a", "chain": { "next": { "other": 1 } } }, "valid": false },
