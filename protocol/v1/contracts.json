[
  {
    "id": "object-validation",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["recipient"],
      "properties": { "recipient": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "instances": [
      { "value": { "recipient": "person@example.test" }, "valid": true },
      { "value": { "recipient": "" }, "valid": false },
      { "value": { "recipient": "ok", "extra": true }, "valid": false }
    ]
  },
  {
    "id": "bundled-reference",
    "schema": {
      "$defs": { "identifier": { "type": "integer", "minimum": 1 } },
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "minItems": 1
    },
    "instances": [
      { "value": [1, 2], "valid": true },
      { "value": [0], "valid": false }
    ]
  },
  {
    "id": "format-is-annotation",
    "schema": { "type": "string", "format": "email" },
    "instances": [{ "value": "deliberately not an email", "valid": true }]
  },
  {
    "id": "union-type",
    "schema": { "type": ["string", "number"] },
    "instances": [
      { "value": "text", "valid": true },
      { "value": 1.5, "valid": true },
      { "value": true, "valid": false }
    ]
  },
  {
    "id": "properties-without-object-type",
    "schema": { "properties": { "count": { "type": "integer" } } },
    "instances": [
      { "value": { "count": 1 }, "valid": true },
      { "value": "not an object", "valid": true },
      { "value": { "count": "one" }, "valid": false }
    ]
  },
  {
    "id": "prefix-items-without-tuple-bounds",
    "schema": { "type": "array", "prefixItems": [{ "type": "string" }] },
    "instances": [
      { "value": [], "valid": true },
      { "value": ["first", 2], "valid": true },
      { "value": [1], "valid": false }
    ]
  },
  {
    "id": "required-without-properties",
    "schema": { "type": "object", "required": ["id"] },
    "instances": [
      { "value": { "id": 1 }, "valid": true },
      { "value": {}, "valid": false }
    ]
  },
  {
    "id": "dependent-keywords-without-their-anchor",
    "schema": { "type": "array", "minContains": 2, "then": false },
    "instances": [
      { "value": [], "valid": true },
      { "value": "not an array", "valid": false }
    ]
  },
  {
    "id": "remote-reference-rejected",
    "schema": { "$ref": "https://example.com/external.json" },
    "schemaError": true
  },
  {
    "id": "dynamic-reference-rejected",
    "schema": { "$dynamicRef": "#node" },
    "schemaError": true
  },
  {
    "id": "unevaluated-properties-rejected",
    "schema": { "type": "object", "unevaluatedProperties": false },
    "schemaError": true
  },
  {
    "id": "custom-keyword-rejected",
    "schema": { "type": "string", "workhorseCustom": true },
    "schemaError": true
  },
  {
    "id": "pattern-rejected",
    "schema": { "type": "string", "pattern": "^a$" },
    "schemaError": true
  },
  {
    "id": "pattern-properties-rejected",
    "schema": { "type": "object", "patternProperties": { "^a": { "type": "string" } } },
    "schemaError": true
  },
  {
    "id": "pattern-in-defs-rejected",
    "schema": {
      "$defs": { "code": { "type": "string", "pattern": "^a$" } },
      "$ref": "#/$defs/code"
    },
    "schemaError": true
  },
  {
    "id": "pattern-in-items-rejected",
    "schema": { "type": "array", "items": { "type": "string", "pattern": "^a$" } },
    "schemaError": true
  },
  {
    "id": "pattern-in-properties-rejected",
    "schema": {
      "type": "object",
      "properties": { "code": { "type": "string", "pattern": "^a$" } }
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-in-defs-rejected",
    "schema": {
      "$defs": { "codes": { "type": "object", "patternProperties": { "^a": true } } },
      "$ref": "#/$defs/codes"
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-in-items-rejected",
    "schema": {
      "type": "array",
      "items": { "type": "object", "patternProperties": { "^a": true } }
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-in-properties-rejected",
    "schema": {
      "type": "object",
      "properties": { "codes": { "type": "object", "patternProperties": { "^a": true } } }
    },
    "schemaError": true
  },
  {
    "id": "properties-named-after-pattern-keywords",
    "schema": {
      "type": "object",
      "required": ["pattern"],
      "properties": { "pattern": { "type": "string" }, "patternProperties": { "type": "integer" } }
    },
    "instances": [
      { "value": { "pattern": "^a$", "patternProperties": 1 }, "valid": true },
      { "value": { "pattern": 1 }, "valid": false },
      { "value": {}, "valid": false }
    ]
  },
  {
    "id": "pattern-behind-reference-rejected",
    "schema": { "default": { "type": "string", "pattern": "^a$" }, "$ref": "#/default" },
    "schemaError": true
  },
  {
    "id": "pattern-properties-behind-reference-rejected",
    "schema": {
      "examples": [{ "type": "object", "patternProperties": { "^a": true } }],
      "$ref": "#/examples/0"
    },
    "schemaError": true
  },
  {
    "id": "pattern-behind-encoded-separator-rejected",
    "schema": {
      "$defs": { "x": { "default": { "type": "string", "pattern": "^a$" } }, "x/default": true },
      "$ref": "#/$defs/x%2Fdefault"
    },
    "schemaError": true
  },
  {
    "id": "pattern-properties-behind-encoded-separator-rejected",
    "schema": {
      "$defs": {
        "x": { "default": { "type": "object", "patternProperties": { "^a": false } } },
        "x/default": true
      },
      "$ref": "#/$defs/x%2Fdefault"
    },
    "schemaError": true
  },
  {
    "id": "reference-with-trailing-percent-rejected",
    "schema": { "$defs": { "x%": { "type": "string" } }, "$ref": "#/$defs/x%" },
    "schemaError": true
  },
  {
    "id": "reference-with-one-digit-escape-rejected",
    "schema": { "$defs": { "x%2": { "type": "string" } }, "$ref": "#/$defs/x%2" },
    "schemaError": true
  },
  {
    "id": "reference-with-non-hexadecimal-escape-rejected",
    "schema": { "$defs": { "key%GG": { "type": "string" } }, "$ref": "#/$defs/key%GG" },
    "schemaError": true
  },
  {
    "id": "reference-with-half-hexadecimal-escape-rejected",
    "schema": { "$defs": { "x%2G": { "type": "string" } }, "$ref": "#/$defs/x%2G" },
    "schemaError": true
  },
  {
    "id": "reference-outside-schema-rejected",
    "schema": { "default": { "type": "string" }, "$ref": "#/default" },
    "schemaError": true
  },
  {
    "id": "anchor-outside-schema-rejected",
    "schema": { "default": { "$anchor": "code", "type": "string" }, "$ref": "#code" },
    "schemaError": true
  },
  {
    "id": "unresolved-reference-rejected",
    "schema": { "$ref": "#/$defs/missing" },
    "schemaError": true
  },
  {
    "id": "references-to-subschemas",
    "schema": {
      "$defs": { "a/b": { "type": "integer" }, "named": { "$anchor": "count", "minimum": 0 } },
      "type": "object",
      "properties": {
        "x": { "$ref": "#/$defs/a~1b" },
        "y": { "$ref": "#count" },
        "z": { "$ref": "#/properties/x" },
        "self": { "$ref": "#" }
      },
      "additionalProperties": false
    },
    "instances": [
      { "value": { "x": 1, "y": 2, "z": 3, "self": { "x": 4 } }, "valid": true },
      { "value": { "x": "a" }, "valid": false },
      { "value": { "y": -1 }, "valid": false },
      { "value": { "z": "a" }, "valid": false },
      { "value": { "self": { "other": 1 } }, "valid": false }
    ]
  },
  {
    "id": "references-with-escaped-names",
    "schema": {
      "$defs": {
        "key%GG": { "type": "integer" },
        "caf\u00e9": { "type": "string" },
        "a~b": { "type": "boolean" },
        "a/b": { "type": "null" }
      },
      "type": "object",
      "properties": {
        "percent": { "$ref": "#/$defs/key%25GG" },
        "multibyte": { "$ref": "#/$defs/caf%C3%A9" },
        "tilde": { "$ref": "#/$defs/a~0b" },
        "slash": { "$ref": "#/$defs/a~1b" }
      },
      "additionalProperties": false
    },
    "instances": [
      { "value": { "percent": 1, "multibyte": "a", "tilde": true, "slash": null }, "valid": true },
      { "value": { "percent": "a" }, "valid": false },
      { "value": { "multibyte": 1 }, "valid": false },
      { "value": { "tilde": 1 }, "valid": false },
      { "value": { "slash": 1 }, "valid": false }
    ]
  }
]
