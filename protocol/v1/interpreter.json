[
  {
    "id": "matcher-semantics",
    "steps": [
      {
        "id": "accept-supported-types",
        "expect": {
          "any": { "$type": "any" },
          "boolean": { "$type": "boolean" },
          "integer": { "$type": "integer" },
          "number": { "$type": "number" },
          "string": { "$type": "string" },
          "timestamp": { "$type": "timestamp" },
          "uuid": { "$type": "uuid" }
        },
        "actual": {
          "any": null,
          "boolean": true,
          "integer": 7,
          "number": 1.5,
          "string": "value",
          "timestamp": "2026-08-25T12:34:56.789Z",
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        "capture": {
          "sharedInteger": "integer",
          "sharedUuid": "uuid"
        }
      },
      {
        "id": "reuse-captures",
        "expect": {
          "integer": { "$ref": "sharedInteger" },
          "uuid": { "$ref": "sharedUuid" }
        },
        "actual": {
          "integer": 7,
          "uuid": "11111111-1111-4111-8111-111111111111"
        }
      },
      {
        "id": "normalize-driver-values",
        "expect": {
          "integer": 7,
          "json": { "nested": [true, "value"] },
          "timestamp": "2026-08-25T12:34:56.789Z",
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        "actual": {
          "integer": { "$native": "integer", "value": "7" },
          "json": { "$native": "json", "value": { "nested": [true, "value"] } },
          "timestamp": { "$native": "timestamp", "value": "2026-08-25T12:34:56.789Z" },
          "uuid": { "$native": "uuid", "value": "11111111-1111-4111-8111-111111111111" }
        }
      },
      {
        "id": "reject-boolean-as-integer",
        "expect": { "$type": "integer" },
        "actual": true,
        "rejects": true
      },
      {
        "id": "reject-boolean-as-number",
        "expect": { "$type": "number" },
        "actual": false,
        "rejects": true
      },
      {
        "id": "reject-fraction-as-integer",
        "expect": { "$type": "integer" },
        "actual": 1.5,
        "rejects": true
      },
      {
        "id": "reject-invalid-timestamp",
        "expect": { "$type": "timestamp" },
        "actual": "2026-02-30T12:34:56Z",
        "rejects": true
      },
      {
        "id": "reject-non-rfc-timestamp",
        "expect": { "$type": "timestamp" },
        "actual": "2026-08-25 12:34:56Z",
        "rejects": true
      },
      {
        "id": "reject-timestamp-without-offset",
        "expect": { "$type": "timestamp" },
        "actual": "2026-08-25T12:34:56",
        "rejects": true
      },
      {
        "id": "reject-invalid-uuid",
        "expect": { "$type": "uuid" },
        "actual": "11111111-1111-4111-8111-11111111111z",
        "rejects": true
      },
      {
        "id": "reject-compact-uuid",
        "expect": { "$type": "uuid" },
        "actual": "11111111111141118111111111111111",
        "rejects": true
      },
      {
        "id": "reject-non-finite-number",
        "expect": { "$type": "number" },
        "actual": { "$native": "number", "value": "NaN" },
        "rejects": true
      }
    ],
    "errors": [
      {
        "id": "match-structured-error",
        "expect": {
          "code": "P4260",
          "message": "matcher self-test",
          "detail": {
            "count": { "$type": "integer" },
            "jobId": { "$ref": "sharedUuid" },
            "retryable": false
          }
        },
        "actual": {
          "code": "P4260",
          "message": "matcher self-test",
          "detail": {
            "count": 7,
            "jobId": "11111111-1111-4111-8111-111111111111",
            "retryable": false
          }
        }
      }
    ]
  }
]
