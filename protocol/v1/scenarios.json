            "storedRequestDigest": "d9b8cd4f7630f1e5a1de41e6e73089924961fddfbe0e9a0b839f5bf039501d3f"
          }
        }
      }
    ]
  },
  {
    "id": "dependencies",
    "steps": [
      {
        "id": "enqueue-prerequisite",
        "sql": "SELECT jsonb_build_object('jobId', workhorse.enqueue_v1($1, $2, '{}'::jsonb)) AS value",
        "parameters": ["protocol-dependency", "protocol.prerequisite"],
        "expect": { "rows": [{ "value": { "jobId": { "$type": "uuid" } } }] },
        "capture": { "prerequisiteJob": "0.value.jobId" }
      },
      {
        "id": "enqueue-dependent",
        "covers": ["dependencies"],
        "sql": "SELECT jsonb_build_object('jobId', job_id, 'outcome', outcome) AS value FROM workhorse.enqueue_many_v1($1::jsonb)",
        "parameters": [
          [
            {
              "queue": "protocol-dependency",
              "type": "protocol.dependent",
              "payload": {},
              "prerequisiteJobId": { "$ref": "prerequisiteJob" }
            }
