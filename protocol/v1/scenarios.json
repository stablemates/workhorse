[
  {
    "id": "successful-batch-lifecycle",
    "steps": [
      {
        "id": "enqueue-batch",
        "covers": ["enqueue"],
        "sql": "SELECT jsonb_build_object('ordinal', ordinal, 'jobId', job_id, 'outcome', outcome) AS value FROM workhorse.enqueue_many_v1($1::jsonb) ORDER BY ordinal",
        "parameters": [
          [
            { "queue": "protocol-batch", "type": "protocol.first", "payload": { "index": 1 } },
            { "queue": "protocol-batch", "type": "protocol.first", "payload": { "index": 2 } }
          ]
        ],
        "expect": {
          "rows": [
            { "value": { "jobId": { "$type": "uuid" }, "ordinal": 1, "outcome": "accepted" } },
            { "value": { "jobId": { "$type": "uuid" }, "ordinal": 2, "outcome": "accepted" } }
          ]
        },
        "capture": {
          "successfulJob": "0.value.jobId",
          "batchPeerJob": "1.value.jobId"
        }
      },
      {
        "id": "claim",
        "covers": ["claim"],
        "sql": "SELECT jsonb_build_object('jobId', job_id, 'jobType', job_type, 'payload', payload, 'attempt', attempt, 'fenceToken', fence_token) AS value FROM workhorse.claim_v1($1::text, $2::text, $3::integer)",
        "parameters": ["protocol-batch", "protocol-success", 30000],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 1,
                "fenceToken": { "$type": "integer" },
                "jobId": { "$ref": "successfulJob" },
                "jobType": "protocol.first",
                "payload": { "index": 1 }
              }
            }
          ]
        },
        "capture": { "successfulFence": "0.value.fenceToken" }
      },
      {
        "id": "claim-batch-peer",
        "sql": "SELECT jsonb_build_object('jobId', job_id, 'jobType', job_type, 'payload', payload, 'attempt', attempt, 'fenceToken', fence_token) AS value FROM workhorse.claim_v1($1::text, $2::text, $3::integer)",
        "parameters": ["protocol-batch", "protocol-success", 30000],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 1,
                "fenceToken": { "$type": "integer" },
                "jobId": { "$ref": "batchPeerJob" },
                "jobType": "protocol.first",
                "payload": { "index": 2 }
              }
            }
          ]
        },
        "capture": { "batchPeerFence": "0.value.fenceToken" }
      },
      {
        "id": "record-batch-dispatch",
        "sql": "SELECT workhorse.record_batch_dispatch_v1($1::uuid, ARRAY(SELECT jsonb_array_elements_text($2::jsonb)::uuid), ARRAY(SELECT jsonb_array_elements_text($3::jsonb)::integer), ARRAY(SELECT jsonb_array_elements_text($4::jsonb)::bigint), $5::text) AS recorded",
        "parameters": [
          "11111111-1111-4111-8111-111111111111",
          [{ "$ref": "successfulJob" }, { "$ref": "batchPeerJob" }],
          [1, 1],
          [{ "$ref": "successfulFence" }, { "$ref": "batchPeerFence" }],
          "protocol-success"
        ],
        "expect": { "rows": [{ "recorded": 2 }] }
      },
      {
        "id": "record-batch-failure",
        "sql": "SELECT workhorse.record_batch_failure_v1($1::uuid, ARRAY(SELECT jsonb_array_elements_text($2::jsonb)::uuid), ARRAY(SELECT jsonb_array_elements_text($3::jsonb)::integer), ARRAY(SELECT jsonb_array_elements_text($4::jsonb)::bigint), $5::text) AS recorded",
        "parameters": [
          "11111111-1111-4111-8111-111111111111",
          [{ "$ref": "successfulJob" }, { "$ref": "batchPeerJob" }],
          [1, 1],
          [{ "$ref": "successfulFence" }, { "$ref": "batchPeerFence" }],
          "protocol-success"
        ],
        "expect": { "rows": [{ "recorded": 2 }] }
      },
      {
        "id": "heartbeat",
        "covers": ["heartbeat"],
        "sql": "SELECT workhorse.heartbeat_v1($1::uuid, $2::text, $3::bigint, $4::integer) AS status",
        "parameters": [
          { "$ref": "successfulJob" },
          "protocol-success",
          { "$ref": "successfulFence" },
          30000
        ],
        "expect": { "rows": [{ "status": "accepted" }] }
      },
      {
        "id": "checkpoint",
        "covers": ["checkpoint"],
        "sql": "SELECT jsonb_build_object('status', status, 'value', checkpoint_value, 'attempt', attempt, 'fenceToken', fence_token, 'workerId', worker_id) AS value FROM workhorse.save_checkpoint_v1($1::uuid, $2::text, $3::bigint, $4::text, $5::jsonb)",
        "parameters": [
          { "$ref": "successfulJob" },
          "protocol-success",
          { "$ref": "successfulFence" },
          "prepared",
          { "answer": 42 }
        ],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 1,
                "fenceToken": { "$ref": "successfulFence" },
                "status": "saved",
                "value": { "answer": 42 },
                "workerId": "protocol-success"
              }
            }
          ]
        }
      },
      {
        "id": "update-progress",
        "sql": "SELECT jsonb_build_object('status', status, 'value', progress_value, 'revision', revision, 'attempt', attempt, 'fenceToken', fence_token, 'workerId', worker_id) AS value FROM workhorse.update_progress_v1($1::uuid, $2::text, $3::bigint, $4::jsonb)",
        "parameters": [
          { "$ref": "successfulJob" },
          "protocol-success",
          { "$ref": "successfulFence" },
          { "percent": 50 }
        ],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 1,
                "fenceToken": { "$ref": "successfulFence" },
                "revision": 1,
                "status": "updated",
                "value": { "percent": 50 },
                "workerId": "protocol-success"
              }
            }
          ]
        }
      },
      {
        "id": "complete",
        "covers": ["completion"],
        "sql": "SELECT workhorse.complete_v1($1::uuid, $2::text, $3::bigint, $4::jsonb) AS accepted",
        "parameters": [
          { "$ref": "successfulJob" },
          "protocol-success",
          { "$ref": "successfulFence" },
          { "ok": true }
        ],
        "expect": { "rows": [{ "accepted": true }] }
      },
      {
        "id": "completed-transition",
        "sql": "SELECT jsonb_build_object('state', state, 'result', workhorse.dashboard_job_result_v1(job_id), 'attempt', current_attempt) AS value FROM workhorse.dashboard_job_outcome_v1 WHERE job_id = $1::uuid",
        "parameters": [{ "$ref": "successfulJob" }],
        "expect": {
          "rows": [{ "value": { "attempt": 1, "result": { "ok": true }, "state": "succeeded" } }]
        }
      }
    ]
  },
  {
    "id": "retry-and-terminal-failure",
    "steps": [
      {
        "id": "enqueue",
        "sql": "SELECT jsonb_build_object('jobId', workhorse.enqueue_v1($1, $2, $3::jsonb, clock_timestamp(), $4)) AS value",
        "parameters": ["protocol-retry", "protocol.retry", { "attempt": 1 }, 2],
        "expect": { "rows": [{ "value": { "jobId": { "$type": "uuid" } } }] },
        "capture": { "retryJob": "0.value.jobId" }
      },
      {
        "id": "claim-first",
        "sql": "SELECT jsonb_build_object('attempt', attempt, 'fenceToken', fence_token) AS value FROM workhorse.claim_v1($1, $2, 30000)",
        "parameters": ["protocol-retry", "protocol-retry-worker"],
        "expect": { "rows": [{ "value": { "attempt": 1, "fenceToken": { "$type": "integer" } } }] },
        "capture": { "retryFenceOne": "0.value.fenceToken" }
      },
      {
        "id": "fail-for-retry",
        "covers": ["failure", "retry"],
        "sql": "SELECT workhorse.fail_v1($1::uuid, $2, $3::bigint, $4::jsonb, 0) AS state",
        "parameters": [
          { "$ref": "retryJob" },
          "protocol-retry-worker",
          { "$ref": "retryFenceOne" },
          { "name": "TransientError", "message": "try again" }
        ],
        "expect": { "rows": [{ "state": "ready" }] }
      },
      {
        "id": "claim-second",
        "sql": "SELECT jsonb_build_object('attempt', attempt, 'fenceToken', fence_token) AS value FROM workhorse.claim_v1($1, $2, 30000)",
        "parameters": ["protocol-retry", "protocol-retry-worker"],
        "expect": { "rows": [{ "value": { "attempt": 2, "fenceToken": { "$type": "integer" } } }] },
        "capture": { "retryFenceTwo": "0.value.fenceToken" }
      },
      {
        "id": "terminal-failure",
        "sql": "SELECT workhorse.fail_v1($1::uuid, $2, $3::bigint, $4::jsonb, 0) AS state",
        "parameters": [
          { "$ref": "retryJob" },
          "protocol-retry-worker",
          { "$ref": "retryFenceTwo" },
          { "name": "PermanentError", "message": "stop" }
        ],
        "expect": { "rows": [{ "state": "failed" }] }
      },
      {
        "id": "failed-transition",
        "sql": "SELECT jsonb_build_object('state', state, 'attempt', current_attempt, 'error', error) AS value FROM workhorse.dashboard_job_outcome_v1 WHERE job_id = $1::uuid",
        "parameters": [{ "$ref": "retryJob" }],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 2,
                "error": { "message": "stop", "name": "PermanentError" },
                "state": "failed"
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "ownership-expiration-and-recovery",
    "steps": [
      {
        "id": "enqueue-timeout",
        "sql": "SELECT jsonb_build_object('jobId', job_id, 'outcome', outcome) AS value FROM workhorse.enqueue_many_v1($1::jsonb)",
        "parameters": [
          [
            {
              "queue": "protocol-expiration",
              "type": "protocol.timeout",
              "payload": {},
              "executionTimeoutMs": 100,
              "maxAttempts": 2
            }
          ]
        ],
        "expect": {
          "rows": [{ "value": { "jobId": { "$type": "uuid" }, "outcome": "accepted" } }]
        },
        "capture": { "timeoutJob": "0.value.jobId" }
      },
      {
        "id": "claim-timeout",
        "sql": "SELECT jsonb_build_object('fenceToken', fence_token) AS value FROM workhorse.claim_v1($1, $2, 30000)",
        "parameters": ["protocol-expiration", "protocol-timeout-worker"],
        "expect": { "rows": [{ "value": { "fenceToken": { "$type": "integer" } } }] },
        "capture": { "timeoutFence": "0.value.fenceToken" }
      },
      {
        "id": "expire-owned-timeout",
        "sql": "WITH slept AS MATERIALIZED (SELECT pg_sleep(0.15)) SELECT jsonb_build_object('status', status, 'retryState', retry_state) AS value FROM slept CROSS JOIN LATERAL workhorse.expire_owned_telemetry_v1($1::uuid, $2::text, $3::bigint)",
        "parameters": [
          { "$ref": "timeoutJob" },
          "protocol-timeout-worker",
          { "$ref": "timeoutFence" }
        ],
        "expect": {
          "rows": [{ "value": { "retryState": "ready", "status": "timeout_exceeded" } }]
        }
      },
      {
        "id": "enqueue-recovery",
        "sql": "SELECT jsonb_build_object('jobId', workhorse.enqueue_v1($1, $2, '{}'::jsonb, clock_timestamp(), $3)) AS value",
        "parameters": ["protocol-recovery", "protocol.recovery", 2],
        "expect": { "rows": [{ "value": { "jobId": { "$type": "uuid" } } }] },
        "capture": { "recoveryJob": "0.value.jobId" }
      },
      {
        "id": "claim-recovery",
        "sql": "SELECT jsonb_build_object('fenceToken', fence_token) AS value FROM workhorse.claim_v1($1, $2, 100)",
        "parameters": ["protocol-recovery", "protocol-recovery-worker"],
        "expect": { "rows": [{ "value": { "fenceToken": { "$type": "integer" } } }] }
      },
      {
        "id": "make-lease-expired",
        "sql": "UPDATE workhorse.job_runtime SET expires_at = clock_timestamp() - interval '1 millisecond' WHERE job_id = $1::uuid RETURNING state",
        "parameters": [{ "$ref": "recoveryJob" }],
        "expect": { "rows": [{ "state": "active" }] }
      },
      {
        "id": "recover-expired",
        "sql": "SELECT rows_affected, expired_leases, retried FROM workhorse.recover_expired_telemetry_v1($1::integer, $2::integer)",
        "parameters": [100, 0],
        "expect": { "rows": [{ "expired_leases": 1, "retried": 1, "rows_affected": 1 }] }
      }
    ]
  },
  {
    "id": "cancellation",
    "steps": [
      {
        "id": "enqueue-and-claim",
        "sql": "WITH enqueued AS (SELECT workhorse.enqueue_v1($1, $2, '{}'::jsonb) AS job_id), claimed AS (SELECT claim.* FROM enqueued CROSS JOIN LATERAL workhorse.claim_v1($1, $3, 30000) claim) SELECT jsonb_build_object('jobId', job_id, 'fenceToken', fence_token) AS value FROM claimed",
        "parameters": ["protocol-cancel", "protocol.cancel", "protocol-cancel-worker"],
        "expect": {
          "rows": [
            { "value": { "fenceToken": { "$type": "integer" }, "jobId": { "$type": "uuid" } } }
          ]
        },
        "capture": { "cancelJob": "0.value.jobId", "cancelFence": "0.value.fenceToken" }
      },
      {
        "id": "cancel",
        "covers": ["cancellation"],
        "sql": "SELECT jsonb_build_object('status', status, 'state', state, 'requestedBy', requested_by, 'reason', reason) AS value FROM workhorse.cancel_v1($1::uuid, $2, $3)",
        "parameters": [{ "$ref": "cancelJob" }, "protocol-operator", "fixture"],
        "expect": {
          "rows": [
            {
              "value": {
                "reason": "fixture",
                "requestedBy": "protocol-operator",
                "state": "active",
                "status": "cancel_requested"
              }
            }
          ]
        }
      },
      {
        "id": "acknowledge",
        "sql": "SELECT workhorse.acknowledge_cancel_v1($1::uuid, $2::text, $3::bigint) AS accepted",
        "parameters": [
          { "$ref": "cancelJob" },
          "protocol-cancel-worker",
          { "$ref": "cancelFence" }
        ],
        "expect": { "rows": [{ "accepted": true }] }
      },
      {
        "id": "canceled-transition",
        "sql": "SELECT jsonb_build_object('state', state, 'attempt', current_attempt, 'requestedBy', error->>'requested_by', 'reason', error->>'reason') AS value FROM workhorse.dashboard_job_outcome_v1 WHERE job_id = $1::uuid",
        "parameters": [{ "$ref": "cancelJob" }],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 1,
                "reason": "fixture",
                "requestedBy": "protocol-operator",
                "state": "canceled"
              }
            }
          ]
        }
      }
    ]
  },
  {
    "id": "timer-wait",
    "steps": [
      {
        "id": "enqueue-and-claim",
        "sql": "WITH enqueued AS (SELECT workhorse.enqueue_v1($1, $2, '{}'::jsonb) AS job_id), claimed AS (SELECT claim.* FROM enqueued CROSS JOIN LATERAL workhorse.claim_v1($1, $3, 30000) claim) SELECT jsonb_build_object('jobId', job_id, 'fenceToken', fence_token) AS value FROM claimed",
        "parameters": ["protocol-timer", "protocol.timer", "protocol-timer-worker"],
        "expect": {
          "rows": [
            { "value": { "fenceToken": { "$type": "integer" }, "jobId": { "$type": "uuid" } } }
          ]
        },
        "capture": { "timerJob": "0.value.jobId", "timerFence": "0.value.fenceToken" }
      },
      {
        "id": "schedule",
        "covers": ["timer-wait"],
        "sql": "SELECT jsonb_build_object('status', status, 'name', wait_name, 'mode', mode, 'durationMs', duration_ms, 'attempt', attempt, 'fenceToken', fence_token) AS value FROM workhorse.schedule_wait_v1($1::uuid, $2, $3::bigint, $4, $5::bigint, NULL)",
        "parameters": [
          { "$ref": "timerJob" },
          "protocol-timer-worker",
          { "$ref": "timerFence" },
          "pause",
          60000
        ],
        "expect": {
          "rows": [
            {
              "value": {
                "attempt": 1,
                "durationMs": 60000,
                "fenceToken": { "$ref": "timerFence" },
                "mode": "relative",
                "name": "pause",
                "status": "scheduled"
              }
            }
          ]
        }
      },
      {
        "id": "scheduled-transition",
        "sql": "SELECT jsonb_build_object('state', state, 'waitName', wait_name) AS value FROM workhorse.dashboard_job_runtime_v1 WHERE job_id = $1::uuid",
        "parameters": [{ "$ref": "timerJob" }],
        "expect": { "rows": [{ "value": { "state": "scheduled", "waitName": "pause" } }] }
      }
    ]
  },
  {
    "id": "coalescing-and-structured-errors",
