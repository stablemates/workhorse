    "maxAttempts": 1,
    "injection": {
      "function": "workhorse.expire_owned_telemetry_v1(uuid,text,bigint)",
      "header": "workhorse.expire_owned_telemetry_v1(p_task_id uuid, p_worker_id text, p_fence_token bigint) RETURNS TABLE (status text, retry_state text)",
      "setup": [
        "CREATE SEQUENCE workhorse.protocol_injected_expiry_calls MINVALUE 0 START 0",
        "CREATE SEQUENCE workhorse.protocol_injected_expiry_released MINVALUE 0 START 0",
        "DO $copy$ BEGIN EXECUTE replace(pg_get_functiondef('workhorse.expire_owned_telemetry_v1(uuid,text,bigint)'::regprocedure), 'FUNCTION workhorse.expire_owned_telemetry_v1(', 'FUNCTION workhorse.protocol_original_expire_owned_telemetry_v1('); END $copy$"
      ],
      "body": "DECLARE v_polls integer := 0; BEGIN IF nextval('workhorse.protocol_injected_expiry_calls') = 0 THEN RAISE EXCEPTION 'injected expiry request failure' USING ERRCODE = '55P03'; END IF; WHILE NOT (SELECT is_called FROM workhorse.protocol_injected_expiry_released) LOOP IF v_polls >= 2000 THEN RAISE EXCEPTION 'the runner never released the expiry request' USING ERRCODE = '55000'; END IF; PERFORM pg_sleep(0.005); v_polls := v_polls + 1; END LOOP; RETURN QUERY SELECT * FROM workhorse.protocol_original_expire_owned_telemetry_v1(p_task_id, p_worker_id, p_fence_token); END;",
      "callsQuery": "SELECT CASE WHEN is_called THEN last_value + 1 ELSE 0 END AS calls FROM workhorse.protocol_injected_expiry_calls",
      "release": "SELECT nextval('workhorse.protocol_injected_expiry_released')",
      "teardown": [
        "DROP FUNCTION IF EXISTS workhorse.protocol_original_expire_owned_telemetry_v1(uuid,text,bigint)",
        "DROP SEQUENCE IF EXISTS workhorse.protocol_injected_expiry_released",
        "DROP SEQUENCE IF EXISTS workhorse.protocol_injected_expiry_calls"
      ]
    },
    "expectedMinimumExpiryRequests": 2,
    "expectedAbortReasons": ["DeadlineExceededError"],
    "expectedCancelledAfterDatabaseExpiry": true,
    "expectedAfterRuns": [
      {
        "state": "failed",
        "attempt": 1,
        "errorName": "DeadlineExceeded"
      }
    ],
    "expectedAttemptOutcomes": ["deadline_exceeded"],
    "followingTaskType": "protocol.deadline-failed-request-following",
    "expectedFollowingState": {
      "state": "succeeded",
      "attempt": 1
    }
