  {
    "id": "timer-wait-suspends-after-a-stale-heartbeat-in-flight",
    "kind": "suspension-race",
    "covers": ["durable-wait-suspension"],
    "taskType": "protocol.suspension-race",
    "waitName": "after-stale-heartbeat",
    "waitMs": 3600000,
    "leaseMs": 30000,
    "heartbeatMs": 100,
    "cancellationTimeoutMs": 10000,
    "injection": {
      "function": "workhorse.schedule_wait_v1(uuid,text,bigint,text,bigint,timestamptz)",
      "header": "workhorse.schedule_wait_v1(p_task_id uuid, p_worker_id text, p_fence_token bigint, p_wait_name text, p_duration_ms bigint, p_wake_at timestamptz) RETURNS TABLE (status text, wait_name text, mode text, duration_ms bigint, requested_wake_at timestamptz, wake_at timestamptz, attempt integer, fence_token bigint, worker_id text, created_at timestamptz)",
      "setup": [
        "CREATE SEQUENCE workhorse.protocol_injected_wait_requested MINVALUE 0 START 0",
        "CREATE SEQUENCE workhorse.protocol_injected_wait_released MINVALUE 0 START 0",
        "DO $copy$ BEGIN EXECUTE replace(pg_get_functiondef('workhorse.schedule_wait_v1(uuid,text,bigint,text,bigint,timestamptz)'::regprocedure), 'FUNCTION workhorse.schedule_wait_v1(', 'FUNCTION workhorse.protocol_original_schedule_wait_v1('); END $copy$"
      ],
      "body": "DECLARE v_polls integer := 0; BEGIN PERFORM nextval('workhorse.protocol_injected_wait_requested'); WHILE NOT (SELECT is_called FROM workhorse.protocol_injected_wait_released) LOOP IF v_polls >= 2000 THEN RAISE EXCEPTION 'the runner never released the wait request' USING ERRCODE = '55000'; END IF; PERFORM pg_sleep(0.005); v_polls := v_polls + 1; END LOOP; RETURN QUERY SELECT 'scheduled'::text, w.wait_name, w.mode, w.duration_ms, w.requested_wake_at, w.wake_at, w.attempt, w.fence_token, w.worker_id, w.created_at FROM workhorse.task_wait w WHERE w.task_id = p_task_id AND w.wait_name = p_wait_name; END;",
      "requestedQuery": "SELECT is_called::text AS requested FROM workhorse.protocol_injected_wait_requested",
      "commit": "SELECT scheduled.status FROM workhorse.task_runtime runtime JOIN workhorse.task task ON task.id = runtime.task_id CROSS JOIN LATERAL workhorse.protocol_original_schedule_wait_v1(runtime.task_id, runtime.worker_id, runtime.fence_token, 'after-stale-heartbeat', 3600000, NULL) AS scheduled WHERE task.task_type = 'protocol.suspension-race' AND runtime.state = 'active'",
      "release": "SELECT nextval('workhorse.protocol_injected_wait_released')",
      "teardown": [
        "DROP FUNCTION IF EXISTS workhorse.protocol_original_schedule_wait_v1(uuid,text,bigint,text,bigint,timestamptz)",
        "DROP SEQUENCE IF EXISTS workhorse.protocol_injected_wait_released",
        "DROP SEQUENCE IF EXISTS workhorse.protocol_injected_wait_requested"
      ]
    },
    "expectedRunsAfterWait": 0,
    "expectedState": {
      "state": "scheduled",
      "attempt": 1
    },
    "expectedAttempts": 0
  },
