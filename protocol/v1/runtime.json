[
  {
    "id": "priority-ordered-mixed-batch",
    "kind": "batch",
    "covers": ["batch-handling"],
    "jobType": "protocol.batch",
    "concurrency": 3,
    "batchMaxSize": 3,
    "jobs": [
      { "key": "succeed", "priority": 90, "maxAttempts": 1, "outcome": "succeed" },
      { "key": "retry", "priority": 50, "maxAttempts": 2, "outcome": "retry" },
      { "key": "fail", "priority": 10, "maxAttempts": 1, "outcome": "fail" }
    ],
    "expectedHandlerOrder": ["succeed", "retry", "fail"],
    "expectedAfterFirstRun": {
      "succeed": { "state": "succeeded", "attempt": 1 },
      "retry": { "state": "ready", "attempt": 2 },
      "fail": { "state": "failed", "attempt": 1 }
    },
    "expectedAfterSecondRun": {
      "succeed": { "state": "succeeded", "attempt": 1 },
      "retry": { "state": "succeeded", "attempt": 2 },
      "fail": { "state": "failed", "attempt": 1 }
    }
  },
  {
    "id": "durable-wait-suspension-and-checkpoint-replay",
    "kind": "suspension-replay",
    "covers": [
      "durable-wait-suspension",
      "worker-slot-release",
      "single-attempt-replay",
      "checkpoint-replay"
    ],
    "jobType": "protocol.suspension-replay",
    "followingJobType": "protocol.after-suspension",
    "checkpointName": "prepare",
    "waitName": "after-prepare",
    "waitMs": 30,
    "expectedHandlerOrder": ["suspension:1", "following:1", "suspension:1"],
    "expectedAfterSuspension": {
      "suspension": { "state": "scheduled", "attempt": 1 },
      "following": { "state": "ready", "attempt": 1 }
    },
    "expectedAfterSlotRelease": {
      "suspension": { "state": "scheduled", "attempt": 1 },
      "following": { "state": "succeeded", "attempt": 1 }
    },
    "expectedAfterReplay": {
      "suspension": { "state": "succeeded", "attempt": 1 },
      "following": { "state": "succeeded", "attempt": 1 }
    },
    "expectedHandlerRuns": 2,
    "expectedCheckpointOperations": 1,
    "expectedAttemptsAfterSuspension": 0,
    "expectedAttemptsAfterReplay": 1
  },
  {
    "id": "cooperative-cancellation-reaches-handler",
    "kind": "cooperative-cancellation",
    "covers": ["cooperative-cancellation-delivery"],
    "jobType": "protocol.cooperative-cancellation",
    "leaseMs": 5000,
    "heartbeatMs": 20,
    "cancelReason": "runtime fixture cancellation",
    "expectedAbortReason": "CancellationRequestedError",
    "expectedState": { "state": "canceled", "attempt": 1 },
    "expectedAttemptOutcome": "canceled"
  },
  {
    "id": "deadline-settles-after-early-local-timer",
    "kind": "expiration",
    "covers": ["deadline-settlement", "database-authoritative-expiration"],
    "jobType": "protocol.deadline",
    "mode": "deadline",
    "durationMs": 200,
    "localClockLeadMs": 100,
    "leaseMs": 5000,
    "heartbeatMs": 20,
    "maxAttempts": 2,
    "expectedAbortReasons": ["DeadlineExceededError"],
    "expectedAfterRuns": [{ "state": "failed", "attempt": 1, "errorName": "DeadlineExceeded" }],
    "expectedAttemptOutcomes": ["deadline_exceeded"]
  },
  {
    "id": "deadline-settles-after-database-first-heartbeat",
    "kind": "expiration",
    "covers": ["deadline-settlement", "database-authoritative-expiration"],
    "jobType": "protocol.deadline-heartbeat",
    "mode": "deadline",
    "durationMs": 300,
    "localClockLeadMs": -150,
    "leaseMs": 5000,
    "heartbeatMs": 20,
    "maxAttempts": 2,
    "expectedAbortReasons": ["DeadlineExceededError"],
    "expectedAfterRuns": [{ "state": "failed", "attempt": 1, "errorName": "DeadlineExceeded" }],
    "expectedAttemptOutcomes": ["deadline_exceeded"]
  },
  {
    "id": "execution-timeout-settles-after-early-local-timer",
    "kind": "expiration",
    "covers": ["execution-timeout-settlement", "database-authoritative-expiration"],
    "jobType": "protocol.execution-timeout",
    "mode": "execution-timeout",
    "durationMs": 200,
    "localClockLeadMs": 100,
    "leaseMs": 5000,
    "heartbeatMs": 20,
    "maxAttempts": 2,
    "expectedAbortReasons": ["ExecutionTimeoutError", "ExecutionTimeoutError"],
    "expectedAfterRuns": [
      { "state": "ready", "attempt": 2 },
      { "state": "failed", "attempt": 2, "errorName": "ExecutionTimeout" }
    ],
    "expectedAttemptOutcomes": ["timeout", "timeout"]
  },
  {
    "id": "lease-loss-fences-handler-writes",
    "kind": "lease-loss",
    "covers": ["lease-loss-fencing"],
    "jobType": "protocol.lease-loss",
    "leaseMs": 500,
    "heartbeatMs": 20,
    "maxAttempts": 2,
    "expectedAbortMessage": "Job lease was lost",
    "expectedRejectedWrites": [
      "setProgress",
      "checkpoint",
      "sleep",
      "sleepUntil",
      "waitForSignal",
      "waitForHuman",
      "runChild",
      "runChildren"
    ],
    "portableRejectedWrites": [
      "checkpoint",
      "sleep",
      "sleepUntil",
      "waitForSignal",
      "waitForHuman",
      "runChild",
      "runChildren"
    ],
    "expectedRejectedWriteError": "Job lease was lost",
    "expectedState": { "state": "ready", "attempt": 2 },
    "expectedAttemptOutcome": "lease_expired"
  },
  {
