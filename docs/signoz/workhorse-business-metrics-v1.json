{
  "schemaVersion": "v6",
  "name": "workhorse-jobs",
  "image": "/assets/Icons/eight-ball",
  "tags": [
    {
      "key": "component",
      "value": "workhorse"
    },
    {
      "key": "managed-by",
      "value": "workhorse"
    }
  ],
  "spec": {
    "display": {
      "name": "Workhorse jobs",
      "description": "Job throughput, outcomes, runtime, capacity, and queue pressure. Environment and service filters use OpenTelemetry resource attributes."
    },
    "duration": "6h",
    "refreshInterval": "1m",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "environment",
          "display": {
            "name": "Environment"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "deployment.environment.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "Service"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "service.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "queue",
          "display": {
            "name": "Queue"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "workhorse.queue.name",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "task",
          "display": {
            "name": "Task type"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "workhorse.job.type",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "links": [],
    "panels": {
      "11111111-1111-4111-8111-111111111111": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Enqueued tasks",
            "description": "Tasks accepted for durable execution per second, stacked by task type."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "ops",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "workhorse.job.enqueued",
                        "temporality": "",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                    },
                    "groupBy": [
                      {
                        "name": "workhorse.job.type",
                        "fieldDataType": "string",
                        "fieldContext": "attribute"
                      }
                    ],
                    "legend": "{{workhorse.job.type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "22222222-2222-4222-8222-222222222222": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Started tasks",
            "description": "Tasks claimed for execution per second, stacked by task type."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "ops",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "workhorse.job.claimed",
                        "temporality": "",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                    },
                    "groupBy": [
                      {
                        "name": "workhorse.job.type",
                        "fieldDataType": "string",
                        "fieldContext": "attribute"
                      }
                    ],
                    "legend": "{{workhorse.job.type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "33333333-3333-4333-8333-333333333333": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Running and waiting tasks",
            "description": "Current scheduled, ready, and active work, stacked by queue and state."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "0"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "workhorse.job.count",
                        "temporality": "",
                        "timeAggregation": "latest",
                        "spaceAggregation": "max",
                        "reduceTo": "last"
                      }
                    ],
                    "filter": {
                      "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue"
                    },
                    "groupBy": [
                      {
                        "name": "workhorse.queue.name",
                        "fieldDataType": "string",
                        "fieldContext": "attribute"
                      },
                      {
                        "name": "workhorse.job.state",
                        "fieldDataType": "string",
                        "fieldContext": "attribute"
                      }
                    ],
                    "legend": "{{workhorse.queue.name}} {{workhorse.job.state}}"
                  }
                }
              }
            }
          ]
        }
      },
      "44444444-4444-4444-8444-444444444444": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Completed tasks",
            "description": "Terminal task executions per second, stacked by task type."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "ops",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "workhorse.job.execution",
                        "temporality": "",
                        "timeAggregation": "rate",
                        "spaceAggregation": "sum",
                        "reduceTo": "sum"
                      }
                    ],
                    "filter": {
                      "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task AND workhorse.job.outcome IN ['canceled', 'deadline_exceeded', 'failed', 'succeeded', 'timeout']"
                    },
                    "groupBy": [
                      {
                        "name": "workhorse.job.type",
                        "fieldDataType": "string",
                        "fieldContext": "attribute"
                      }
                    ],
                    "legend": "{{workhorse.job.type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "55555555-5555-4555-8555-555555555555": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Execution outcomes",
            "description": "Handler outcomes per second, stacked by task type and outcome."
          },
          "plugin": {
            "kind": "signoz/BarChartPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "stackedBarChart": true
              },
              "formatting": {
                "unit": "ops",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.job.type",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            },
                            {
                              "name": "workhorse.job.outcome",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ],
                          "legend": "{{workhorse.job.type}} {{workhorse.job.outcome}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "66666666-6666-4666-8666-666666666666": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Handler runtime percentiles",
            "description": "p50, p95, and p99 handler duration in seconds, grouped by task type."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "s",
                "decimalPrecision": "1"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution.duration.bucket",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "p50",
                              "reduceTo": "last"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.job.type",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ],
                          "legend": "p50 {{workhorse.job.type}}"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution.duration.bucket",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "p95",
                              "reduceTo": "last"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.job.type",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ],
                          "legend": "p95 {{workhorse.job.type}}"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "C",
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution.duration.bucket",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "p99",
                              "reduceTo": "last"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.job.type",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ],
                          "legend": "p99 {{workhorse.job.type}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "77777777-7777-4777-8777-777777777777": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "10 slowest task types",
            "description": "Task types ranked by p95 workhorse.handler span duration. This panel follows trace sampling; use the histogram panel for unsampled percentiles."
          },
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "formatting": {
                "columnUnits": {
                  "A": "ns"
                },
                "decimalPrecision": "1"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)",
                        "alias": "P95 handler duration"
                      }
                    ],
                    "filter": {
                      "expression": "name = 'workhorse.handler' AND deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task"
                    },
                    "groupBy": [
                      {
                        "name": "workhorse.job.type",
                        "fieldDataType": "string",
                        "fieldContext": "span"
                      }
                    ],
                    "limit": 10,
                    "order": [
                      {
                        "key": {
                          "name": "p95(duration_nano)"
                        },
                        "direction": "desc"
                      }
                    ],
                    "legend": "{{workhorse.job.type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "88888888-8888-4888-8888-888888888888": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Worker slots",
            "description": "Declared and occupied execution slots by queue."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "disabled": false,
                          "aggregations": [
                            {
                              "metricName": "workhorse.worker.capacity",
                              "temporality": "",
                              "timeAggregation": "latest",
                              "spaceAggregation": "sum",
                              "reduceTo": "last"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.queue.name",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ],
                          "legend": "capacity {{workhorse.queue.name}}"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "disabled": false,
                          "aggregations": [
                            {
                              "metricName": "workhorse.worker.active",
                              "temporality": "",
                              "timeAggregation": "latest",
                              "spaceAggregation": "sum",
                              "reduceTo": "last"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.queue.name",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ],
                          "legend": "active {{workhorse.queue.name}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "99999999-9999-4999-8999-999999999999": {
