                  }
                }
              }
            }
          ]
        }
      },
      "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Estimated queue drain time",
            "description": "Ready depth divided by the current completion rate. Queues with no completions have no finite estimate."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "s",
                "decimalPrecision": "1"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "disabled": true,
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.count",
                              "temporality": "",
                              "timeAggregation": "latest",
                              "spaceAggregation": "max",
                              "reduceTo": "last"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.state = 'ready'"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.queue.name",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "disabled": true,
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.outcome = 'succeeded'"
                          },
                          "groupBy": [
                            {
                              "name": "workhorse.queue.name",
                              "fieldDataType": "string",
                              "fieldContext": "attribute"
                            }
                          ]
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "A / B"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "cccccccc-cccc-4ccc-8ccc-cccccccccccc": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Terminal success rate",
            "description": "Successful terminal executions divided by all terminal executions."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "%",
                "decimalPrecision": "1"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "disabled": true,
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task AND workhorse.job.outcome = 'succeeded'"
                          }
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "disabled": true,
                          "aggregations": [
                            {
                              "metricName": "workhorse.job.execution",
                              "temporality": "",
                              "timeAggregation": "rate",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "filter": {
                            "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue AND workhorse.job.type IN $task AND workhorse.job.outcome IN ['canceled', 'deadline_exceeded', 'failed', 'timeout']"
                          }
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "name": "F1",
                          "expression": "100 * A / (A + B)"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
