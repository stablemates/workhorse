                      },
                      {
                        "name": "workhorse.job.state",
                        "fieldDataType": "string",
                        "fieldContext": "attribute"
                      }
                    ],
                    "legend": "{{workhorse.queue.name}} {{workhorse.job.state}}"
                  }
                }
              }
            }
          ]
        }
      },
      "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Oldest ready job",
            "description": "Age in seconds of the oldest ready job in each queue."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "s",
                "decimalPrecision": "0"
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "workhorse.queue.oldest_ready.age",
                        "temporality": "",
                        "timeAggregation": "latest",
                        "spaceAggregation": "max",
                        "reduceTo": "last"
                      }
                    ],
                    "filter": {
                      "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue"
                    },
                    "groupBy": [
                      {
