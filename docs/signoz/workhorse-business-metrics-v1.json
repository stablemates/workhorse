                      }
                    ],
                    "filter": {
                      "expression": "deployment.environment.name IN $environment AND service.name IN $service AND workhorse.queue.name IN $queue"
                    },
                    "groupBy": [
                      {
                        "name": "workhorse.queue.name",
                        "fieldDataType": "string",
