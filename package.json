{
  "name": "@workhorse/core",
  "version": "0.1.0",
  "private": false,
  "description": "Evidence-first PostgreSQL durable job queue validation MVP",
  "bin": {
    "workhorse-bench": "./dist/src/cli/benchmark.js",
    "workhorse-bench-competitors": "./dist/src/cli/benchmark-competitors.js",
    "workhorse-health": "./dist/src/cli/health.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm build:runtime && pnpm --filter @workhorse/demo build",
    "build:runtime": "pnpm build:core && pnpm --filter './packages/*' build",
    "demo": "pnpm db:reset:demo && pnpm build:runtime && pnpm --filter @workhorse/demo dev",
    "build:core": "tsc -p tsconfig.build.json && rm -rf dist/sql && cp -R sql dist/sql",
    "typecheck": "pnpm typecheck:core && pnpm build:core && pnpm --filter './packages/*' typecheck && pnpm --filter @workhorse/demo typecheck",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration.test.ts",
    "test:packed": "tsx test/packed-packages.ts",
    "test:demo-smoke": "tsx test/demo-smoke.ts",
    "health": "tsx src/cli/health.ts --database dev",
    "health:bench": "tsx src/cli/health.ts --database bench",
    "benchmark": "tsx src/cli/benchmark.ts",
    "benchmark:competitors": "tsx src/cli/benchmark-competitors.ts",
    "lint": "oxlint --deny-warnings --import-plugin --vitest-plugin src test benchmarks packages demo vitest.config.ts",
    "lint:fix": "oxlint --fix --import-plugin --vitest-plugin src test benchmarks packages demo vitest.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:packed && pnpm test:demo-smoke",
    "db:reset": "pnpm db:reset:dev",
    "db:reset:dev": "tsx src/cli/reset-db.ts --database dev --yes",
    "db:reset:test": "tsx src/cli/reset-db.ts --database test --yes",
    "db:reset:bench": "tsx src/cli/reset-db.ts --database bench --yes",
    "db:reset:demo": "tsx src/cli/reset-db.ts --database demo --yes",
    "db:reset:all": "pnpm db:reset:dev && pnpm db:reset:test && pnpm db:reset:bench && pnpm db:reset:demo"
  },
  "dependencies": {
    "cron-parser": "5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "graphile-worker": "0.17.3",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "pg-boss": "12.26.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
