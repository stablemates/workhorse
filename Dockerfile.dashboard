FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate

ARG BUILD_CONCURRENCY=4
ENV GOMAXPROCS=${BUILD_CONCURRENCY}
ENV PNPM_CONFIG_NETWORK_CONCURRENCY=${BUILD_CONCURRENCY}
ENV PNPM_CONFIG_MAX_SOCKETS=${BUILD_CONCURRENCY}

# V8 sizes every heap at 4288 MB whatever the host has, so compilers running here can promise more
# memory than a small continuous integration runner owns. Only the build stage sets this, so the
# published image keeps Node's defaults.
ENV NODE_OPTIONS=--max-old-space-size=2048

WORKDIR /workhorse
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:runtime
RUN mkdir /artifacts \
  && pnpm --silent --dir typescript/core pack --pack-destination /artifacts \
  && mv /artifacts/stablemates-workhorse-*.tgz /artifacts/workhorse-core.tgz \
  && pnpm --silent --dir typescript/dashboard-contract pack --pack-destination /artifacts \
  && mv /artifacts/stablemates-workhorse-dashboard-contract-*.tgz /artifacts/workhorse-dashboard-contract.tgz \
  && pnpm --silent --dir typescript/dashboard-server pack --pack-destination /artifacts \
  && mv /artifacts/stablemates-workhorse-dashboard-server-*.tgz /artifacts/workhorse-dashboard-server.tgz \
  && pnpm --silent --dir typescript/dashboard pack --pack-destination /artifacts \
  && mv /artifacts/stablemates-workhorse-dashboard-[0-9]*.tgz /artifacts/workhorse-dashboard.tgz

# The dependencies the four packed packages declare, resolved from the committed lockfile rather
# than from the registry. Installing the tarballs directly would let npm pick whatever satisfies
# `pg@^8.23.0` and every range below it on the day of the build, so the same commit would produce a
# different tree tomorrow. `pnpm deploy` reads pnpm-lock.yaml instead, which pins every version.
#
# One deploy per package that has dependencies. A deploy puts that package's direct dependencies at
# the root of its node_modules and everything below them under node_modules/.pnpm, so the three
# roots merge into one tree in which every import a packed package makes resolves. Their overlap is
# the same version from the same lockfile either way.
RUN pnpm --filter @stablemates/workhorse deploy --prod --legacy /dependencies/core \
  && pnpm --filter @stablemates/workhorse-dashboard-server deploy --prod --legacy /dependencies/dashboard-server \
  && pnpm --filter @stablemates/workhorse-dashboard deploy --prod --legacy /dependencies/dashboard

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS production-dependencies

WORKDIR /opt/workhorse
COPY --from=build /dependencies/core/node_modules/ ./node_modules/
COPY --from=build /dependencies/dashboard-server/node_modules/ ./node_modules/
COPY --from=build /dependencies/dashboard/node_modules/ ./node_modules/
COPY --from=build /artifacts/ /artifacts/

# The four packages themselves come from the tarballs `npm publish` would upload, so the image runs
# what a consumer would install. Each replaces the workspace link the deploy left behind.
RUN set -eu \
  && for entry in \
       workhorse-core:workhorse \
       workhorse-dashboard-contract:workhorse-dashboard-contract \
       workhorse-dashboard-server:workhorse-dashboard-server \
       workhorse-dashboard:workhorse-dashboard; do \
    target="node_modules/@stablemates/${entry#*:}"; \
    rm -rf "$target"; \
    mkdir -p "$target"; \
    tar -xzf "/artifacts/${entry%:*}.tgz" -C "$target" --strip-components=1; \
  done \
  && rm -rf /artifacts

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime

ENV NODE_ENV=production
WORKDIR /opt/workhorse
# root owns the packages and their dependencies, and the node user can only read them, so a
# compromised process cannot replace the code that the next restart loads (SM-1667). The dashboard
# writes no file.
COPY --from=production-dependencies /opt/workhorse/ ./

USER node
# The image build stops here if the node user can write any file under /opt/workhorse, or cannot
# load the dashboard command. BusyBox find has no `-writable`, so a file fails the check when node
# owns it, its group is node, or anyone can write it.
RUN set -eu \
  && node -e 'import("@stablemates/workhorse").then(() => import("@stablemates/workhorse-dashboard-server"))' \
  && if touch /opt/workhorse/.write-probe 2>/dev/null; then echo "The node user can write /opt/workhorse" >&2; exit 1; fi \
  && writable="$(find /opt/workhorse ! -type l \( -user node -o -group node -o -perm -0002 \) -print)" \
  && if [ -n "$writable" ]; then echo "The node user can write application files:" >&2; echo "$writable" >&2; exit 1; fi
EXPOSE 3000
CMD ["node", "node_modules/@stablemates/workhorse/dist/src/cli/workhorse.js", "dashboard", "--host", "0.0.0.0", "--port", "3000"]
