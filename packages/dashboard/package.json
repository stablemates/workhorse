{
  "name": "@workhorse/dashboard",
  "version": "0.1.0",
  "description": "Embeddable React operator dashboard for Workhorse",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "packages/dashboard"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./styles.css": "./dist/styles.css",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/rpc-client.d.ts",
      "import": "./dist/rpc-client.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && pnpm build:library && pnpm build:app",
    "build:dev": "pnpm build:library",
    "build:library": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css && cp -R src/assets dist/assets",
    "build:app": "vite build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev": "vite"
  },
  "dependencies": {
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/notifications": "^8.3.18",
    "@opentelemetry/api-logs": "0.221.0",
    "@orpc/client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@phosphor-icons/react": "^2.1.10",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@workhorse/core": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-grab": "^0.1.50",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "@workhorse/core": ">=0.1.0 <1",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
