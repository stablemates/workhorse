# Review owners for the files that decide what CI and the release jobs execute.
#
# A change to a workflow, to a lockfile, or to the publish script changes what runs against a
# credential, and it does so without touching any code a reviewer would think to read. Naming
# owners here puts a maintainer in front of exactly those paths. Everything else keeps the
# repository's normal review.
#
# This file enforces nothing on its own: it takes effect when branch protection on main requires
# review from code owners.

# Workflows, dependabot, and this file.
/.github/ @skyeagle @leoisadev1

# The published image and the deployment contract it satisfies. Nothing here deploys — the live
# deployment consumes these files from a private operations repository (ADR 0060).
/Dockerfile @skyeagle @leoisadev1
/Dockerfile.dashboard @skyeagle @leoisadev1
/Dockerfile.site @skyeagle @leoisadev1
/typescript/demo/DEPLOYMENT.md @skyeagle @leoisadev1

# The script that holds the npm publication identity and writes to the registry.
/scripts/publish-npm.ts @skyeagle @leoisadev1

# The lockfiles. They are the only record of what a machine installs before any test runs.
/pnpm-lock.yaml @skyeagle @leoisadev1
/python/uv.lock @skyeagle @leoisadev1
/go/go.sum @skyeagle @leoisadev1

# The CI plan. These files decide which lanes a change runs, the test matrix, the check before each
# publish step, and the scripts that a workflow runs by path. A change to one of them can make CI
# skip a suite, and every test still passes. scripts/codeowners-coverage.test.ts requires an owner
# for each script that a workflow names.
/scripts/ci-lanes.ts @skyeagle @leoisadev1
/scripts/ci-matrix.ts @skyeagle @leoisadev1
/scripts/check-main-ci-plan.ts @skyeagle @leoisadev1
/scripts/check-attestation-upload.ts @skyeagle @leoisadev1
/scripts/check-registry-version.ts @skyeagle @leoisadev1
/scripts/check-release-line.ts @skyeagle @leoisadev1
/scripts/upload-maven-central.ts @skyeagle @leoisadev1
/scripts/with-env.ts @skyeagle @leoisadev1

