{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "cargo-deny",
    "dotnet",
    "foundryctl",
    "go",
    "gofmt",
    "gradle",
    "mise",
    "rustfmt",
    "uv"
  ],
  "ignore": ["typescript/dashboard-server/src/server/types.ts"],
  "tags": ["-internal"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/agent-eval/*.ts",
        "scripts/soak/*.ts",
        "vitest*.config.ts"
      ],
      "ignoreDependencies": ["@vitest/coverage-v8", "geist"]
    },
    "dashboard/app": {
      "entry": ["browser/react-grab.ts", "src/browser.tsx", "vite.config.ts"],
      "ignore": ["src/components/graphical/**"],
      "vite": {
        "config": []
      }
    },
    "typescript/core": {
      "entry": ["src/cli/benchmark.ts", "src/cli/reset-db.ts", "src/cli/workhorse.ts"],
      "ignoreDependencies": ["@stablemates/workhorse-dashboard"]
    },
    "typescript/dashboard": {
      "ignoreDependencies": [
        "@hugeicons/core-free-icons",
        "@hugeicons/react",
        "@mantine/charts",
        "@mantine/core",
        "@mantine/hooks",
        "@mantine/notifications",
        "@base-ui/react",
        "@fontsource-variable/geist",
        "lucide-react",
        "motion",
        "@stablemates/workhorse",
        "@stablemates/workhorse-dashboard-server",
        "react",
        "react-dom",
        "recharts",
        "vite"
      ]
    },
    "typescript/adapter-conformance": {
      "ignoreDependencies": ["magicast"]
    },
    "typescript/prisma": {
      "ignoreDependencies": ["@prisma/client"]
    },
    "typescript/typeorm": {
      "ignoreDependencies": ["typeorm"]
    },
    "site": {
      "entry": ["vite.config.ts"],
      "vite": {
        "config": []
      }
    }
  }
}
