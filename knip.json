{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["foundryctl", "go", "gofmt", "uv"],
  "ignore": ["typescript/dashboard-server/src/server/types.ts"],
  "tags": ["-internal"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/agent-eval/*.ts",
        "scripts/soak/*.ts",
        "vitest*.config.ts"
      ],
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "dashboard/app": {
      "entry": ["browser/react-grab.ts", "src/browser.tsx"],
      "vite": {
        "config": []
      }
    },
    "typescript/core": {
      "entry": ["src/cli/benchmark.ts", "src/cli/reset-db.ts", "src/cli/workhorse.ts"],
      "ignoreDependencies": ["@stablemates/workhorse-dashboard"]
    },
    "typescript/dashboard": {
      "ignoreDependencies": [
        "@phosphor-icons/react",
        "@stablemates/workhorse-dashboard-server",
        "@tailwindcss/vite",
        "class-variance-authority",
        "clsx",
        "radix-ui",
        "recharts",
        "sonner",
        "tailwind-merge",
        "tailwindcss",
        "@stablemates/workhorse",
        "react",
        "react-dom",
        "vite"
      ]
    },
    "typescript/adapter-conformance": {
      "ignoreDependencies": ["magicast"]
    },
    "typescript/prisma": {
      "ignoreDependencies": ["@prisma/client"]
    },
    "typescript/typeorm": {
      "ignoreDependencies": ["typeorm"]
    },
    "site": {
      "vite": {
        "config": []
      }
    }
  }
}
