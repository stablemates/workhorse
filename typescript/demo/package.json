{
  "name": "@stablemates/workhorse-demo",
  "version": "0.3.0",
  "private": true,
  "description": "Interactive end-to-end demo of Workhorse",
  "files": [
    "dist",
    "container-entrypoint.mjs",
    "telemetry.cjs",
    "file-log-exporter.cjs"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-server tsx watch --conditions workhorse-source --require ./telemetry.cjs src/index.ts",
    "dev:worker": "tsx watch --conditions workhorse-source --require ./telemetry.cjs src/worker-main.ts",
    "start": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-server node --require ./telemetry.cjs dist/index.js",
    "start:worker": "NODE_OPTIONS=--require=./telemetry.cjs workhorse worker --config dist/worker.js",
    "start:worker:typescript": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-worker-typescript pnpm start:worker",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@orpc/client": "1.15.1",
    "@orpc/server": "1.15.1",
    "@stablemates/workhorse": "workspace:*",
    "@stablemates/workhorse-dashboard-server": "workspace:*",
    "@stablemates/workhorse-drizzle": "workspace:*",
    "@stablemates/workhorse-otel": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@stablemates/workhorse-dashboard": "workspace:*",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
