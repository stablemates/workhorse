{
  "name": "@stablemates/workhorse-dashboard-server",
  "version": "0.1.0-beta.2",
  "description": "Public beta Node.js backend for the Workhorse operator dashboard",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "typescript/dashboard-server"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "workhorse-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "workhorse-source": "./src/wire.ts",
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./server": {
      "workhorse-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./standalone": {
      "workhorse-source": "./src/server/standalone.ts",
      "types": "./dist/server/standalone.d.ts",
      "import": "./dist/server/standalone.js"
    },
    "./client": {
      "workhorse-source": "./src/rpc-client.ts",
      "types": "./dist/rpc-client.d.ts",
      "import": "./dist/rpc-client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm build:library",
    "build:dev": "pnpm build:library",
    "build:library": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.221.0",
    "@orpc/client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@stablemates/workhorse-dashboard-contract": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stablemates/workhorse": "workspace:*",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@stablemates/workhorse": ">=0.1.0-beta.1 <0.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
