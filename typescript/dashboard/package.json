{
  "name": "@workhorse/dashboard",
  "version": "0.1.0",
  "description": "Compatibility facade for the shared Workhorse dashboard application",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "typescript/dashboard"
  },
  "files": [
    "dist",
    "development",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./styles.css": "./dist/styles.css",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist development && cp -R ../../dashboard/app/dist/library dist && mkdir -p development/browser && cp ../../dashboard/app/browser/index.html development/browser/index.html && cp -R ../../dashboard/app/src development/src && find dist -name '*.map' -delete && find development/src -name '*.test.*' -delete && sed -i '/sourceMappingURL=.*\\.map$/d' dist/*.js dist/*.d.ts",
    "build:dev": "pnpm build",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/notifications": "^8.3.18",
    "@workhorse/dashboard-server": "workspace:*",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@workhorse/core": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "@workhorse/core": ">=0.1.0 <0.2.0",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
