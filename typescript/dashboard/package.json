{
  "name": "@stablemates/workhorse-dashboard",
  "version": "0.1.0-beta.1",
  "description": "Public beta compatibility facade for the Workhorse dashboard application",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "typescript/dashboard"
  },
  "files": [
    "dist",
    "development",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "workhorse-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "workhorse-source": "./src/wire.ts",
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./presentation": {
      "workhorse-source": "./src/presentation.ts",
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./styles.css": "./dist/styles.css",
    "./server": {
      "workhorse-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./standalone": {
      "workhorse-source": "./src/standalone.ts",
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./client": {
      "workhorse-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./dev": {
      "workhorse-source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist development && cp -R ../../dashboard/app/dist/library dist && mkdir -p development/browser && cp ../../dashboard/app/browser/index.html development/browser/index.html && cp -R ../../dashboard/app/src development/src && find dist -name '*.map' -delete && find development/src -name '*.test.*' -delete && node ../../scripts/strip-source-map-comments.mjs dist",
    "build:dev": "mkdir -p dist development/browser development/src && cp -R ../../dashboard/app/dist/library/. dist && cp ../../dashboard/app/browser/index.html development/browser/index.html && cp -R ../../dashboard/app/src/. development/src && find dist -name '*.map' -delete && find development/src -name '*.test.*' -delete && node ../../scripts/strip-source-map-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@mantine/notifications": "^8.3.18",
    "@phosphor-icons/react": "^2.1.10",
    "@stablemates/workhorse-dashboard-server": "workspace:*",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@stablemates/workhorse": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "@stablemates/workhorse": ">=0.1.0-beta.1 <0.2.0",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
