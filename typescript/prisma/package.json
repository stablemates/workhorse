{
  "name": "@workhorse-js/prisma",
  "version": "0.1.0",
  "description": "Prisma ORM provider for Workhorse",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "typescript/prisma"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "workhorse-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:dev": "pnpm build",
    "prepare": "prisma generate --schema prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@stablemates/workhorse": "workspace:*",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "prisma": "6.19.3"
  },
  "peerDependencies": {
    "@prisma/client": ">=6 <7",
    "@stablemates/workhorse": ">=0.1.0 <1"
  },
  "engines": {
    "node": ">=22"
  }
}
