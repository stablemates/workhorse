{
  "name": "@workhorse/core",
  "version": "0.1.0",
  "private": false,
  "description": "Evidence-first PostgreSQL durable job queue validation MVP",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "typescript/core"
  },
  "bin": {
    "workhorse": "./dist/src/cli/workhorse.js",
    "workhorse-bench": "./dist/src/cli/benchmark.js",
    "workhorse-bench-competitors": "./dist/src/cli/benchmark-competitors.js",
    "workhorse-health": "./dist/src/cli/health.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm --dir ../.. schema:generate && tsc -p ../../tsconfig.build.json && rm -rf dist/sql && mkdir -p dist/sql && cp ../../sql/schema.sql dist/sql/schema.sql && cp -R ../../sql/migrations dist/sql/migrations",
    "build:dev": "pnpm build",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@workhorse/dashboard-contract": "workspace:*",
    "cron-parser": "5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@workhorse/dashboard": "workspace:*",
    "graphile-worker": "0.17.3",
    "pg-boss": "12.26.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@workhorse/dashboard": ">=0.1.0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@workhorse/dashboard": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
