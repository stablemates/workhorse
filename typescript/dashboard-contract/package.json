{
  "name": "@stablemates/workhorse-dashboard-contract",
  "version": "0.1.0",
  "description": "Compile-time contract between the Workhorse CLI and dashboard package",
  "homepage": "https://workhorse.run",
  "bugs": {
    "url": "https://github.com/stablemates/workhorse/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablemates/workhorse.git",
    "directory": "typescript/dashboard-contract"
  },
  "files": [
    "index.d.ts",
    "README.md"
  ],
  "type": "module",
