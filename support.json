{
  "install": {
    "go": "go get github.com/stablemates/workhorse/go",
    "node": "npm install @stablemates/workhorse",
    "python": "pip install stablemates-workhorse",
    "schema": "npm exec --no -- workhorse schema install",
    "schemaPinned": "npx --package @stablemates/workhorse@0.1.0 workhorse schema install"
  },
  "support": {
    "go": {
      "minimum": "1.25.0"
    },
    "node": {
      "endOfLife": {
        "22": "2027-04-30",
        "24": "2028-04-30"
      },
      "minimum": 22,
      "tested": [22, 24]
    },
    "postgres": {
      "endOfLife": {
        "15": "2027-11-11",
        "16": "2028-11-09",
        "17": "2029-11-08",
        "18": "2030-11-14"
      },
      "minimum": 15,
      "tested": [15, 16, 17, 18]
    },
    "python": {
      "endOfLife": {
        "3.12": "2028-10",
        "3.13": "2029-10",
        "3.14": "2030-10"
      },
      "minimum": "3.12",
      "tested": ["3.12", "3.13", "3.14"]
    }
  },
  "toolchains": {
    "go": "1.25.14",
    "node": "24",
    "pnpm": "10.18.3",
    "uv": "0.8.9"
  }
}
