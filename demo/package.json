{
  "name": "@workhorse/demo",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive end-to-end demo of Workhorse",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "vite",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vite.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@orpc/client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@workhorse/core": "workspace:*",
    "@workhorse/dashboard": "workspace:*",
    "@workhorse/drizzle": "workspace:*",
    "@workhorse/hono": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-grab": "^0.1.50",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
