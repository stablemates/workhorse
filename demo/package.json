{
  "name": "@workhorse/demo",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive end-to-end demo of Workhorse",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-server tsx watch --require ./telemetry.cjs src/index.ts",
    "dev:worker": "tsx watch --require ./telemetry.cjs src/worker-main.ts",
    "start": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-server node --require ./telemetry.cjs dist/index.js",
    "start:worker": "NODE_OPTIONS=--require=./telemetry.cjs workhorse worker --config dist/worker.js",
    "start:worker:one": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-worker-one WORKHORSE_DEMO_WORKER_PROFILE=0 pnpm start:worker",
    "start:worker:two": "WORKHORSE_DEMO_SERVICE_NAME=workhorse-demo-worker-two WORKHORSE_DEMO_WORKER_PROFILE=1 pnpm start:worker",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@orpc/client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@workhorse/core": "workspace:*",
    "@workhorse/dashboard": "workspace:*",
    "@workhorse/drizzle": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
