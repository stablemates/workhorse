{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-await-in-loop": "off",
    "no-promise-executor-return": "error",
    "unicorn/prefer-type-error": "error"
  },
  "env": {
    "builtin": true
  }
}
