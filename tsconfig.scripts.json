{
  "extends": ["./tsconfig.json", "./tsconfig.typecheck-base.json"],
  "compilerOptions": {
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": ".build/typecheck/scripts",
    "rootDir": ".",
    "tsBuildInfoFile": ".build/typecheck/scripts.tsbuildinfo"
  },
  "include": ["scripts/**/*.ts", "vitest*.config.ts"],
  "references": [{ "path": "typescript/core/tsconfig.source.json" }]
}
