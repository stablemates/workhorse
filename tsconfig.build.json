{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "typescript/core",
    "stripInternal": true,
    "tsBuildInfoFile": ".build/core.tsbuildinfo"
  },
  "include": ["typescript/core/src/**/*.ts"],
  "exclude": [
    "typescript/core/test",
    "vitest.config.ts",
    "typescript/core/src/cli/benchmark.ts",
    "typescript/core/src/cli/reset-db.ts"
  ]
}
