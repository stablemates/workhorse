<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The release consumer of `pnpm release:verify nuget` and `pnpm dotnet:package-check` (ADR 0107,
    "Governed surface and release"). It references the four packages at WorkhorseVersion. The target
    copies it to a scratch directory and restores the four packages from nuget.org, or only from the
    local feed of the packed files. It is not in the solution, and it never ships.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Workhorse" Version="[$(WorkhorseVersion)]" />
    <PackageReference Include="Workhorse.Hosting" Version="[$(WorkhorseVersion)]" />
    <PackageReference Include="Workhorse.EntityFrameworkCore" Version="[$(WorkhorseVersion)]" />
    <PackageReference Include="Workhorse.AspNetCore" Version="[$(WorkhorseVersion)]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>
