<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core: client, worker, Admin, durable context, and telemetry (ADR 0107). -->
  <PropertyGroup>
    <PackageId>Workhorse</PackageId>
    <RootNamespace>Workhorse</RootNamespace>
    <Description>The Workhorse client and worker for .NET: a durable task queue on PostgreSQL.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the test project sees the internals. No shipped assembly does (ADR 0107). -->
    <InternalsVisibleTo Include="Workhorse.Tests" />
  </ItemGroup>
</Project>
