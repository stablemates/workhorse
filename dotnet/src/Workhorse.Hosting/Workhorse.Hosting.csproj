<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency injection, options, the hosted worker, and health checks (ADR 0107). -->
  <PropertyGroup>
    <PackageId>Workhorse.Hosting</PackageId>
    <RootNamespace>Workhorse.Hosting</RootNamespace>
    <Description>Dependency injection, options, the hosted worker, and health checks for Workhorse on the .NET Generic Host.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Workhorse/Workhorse.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>
  <ItemGroup>
    <!-- Each Workhorse:* key with its type and default. The API snapshot (SM-1626) reads it. -->
    <EmbeddedResource Include="ConfigurationKeys.json" LogicalName="Workhorse.Hosting.ConfigurationKeys.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the test project sees the internals. No shipped assembly does (ADR 0107). -->
    <InternalsVisibleTo Include="Workhorse.Tests" />
  </ItemGroup>
</Project>
