<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs each region of Workhorse.Examples against a scratch PostgreSQL database. `pnpm dotnet:test`
    starts this executable after the package tests, as scripts/dotnet-test.ts lists them.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>Workhorse.Examples.Tests</RootNamespace>
    <!-- Test code needs no public documentation, and xUnit finds public test classes by reflection. -->
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1707</NoWarn>
    <!-- One scratch database for the process, without a reset (SM-1732). See ScratchDatabase. -->
    <DefineConstants>$(DefineConstants);WORKHORSE_PROCESS_DATABASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Workhorse.Examples/Workhorse.Examples.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The scratch database of the core tests, so every suite makes databases one way. -->
    <Compile Include="../../tests/Workhorse.Tests/Testing/ScratchDatabase.cs" Link="Testing/ScratchDatabase.cs" />
    <AssemblyMetadata Include="WorkhorseSchema" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../sql/schema/current.sql'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
