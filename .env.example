# Application runtime and manual development
DATABASE_URL=postgres://workhorse:workhorse@localhost:5432/workhorse_dev

# Repository tooling. Each command reads only its purpose-specific variable.
WORKHORSE_DEV_DATABASE_URL=postgres://workhorse:workhorse@localhost:5432/workhorse_dev
WORKHORSE_TEST_DATABASE_URL=postgres://workhorse:workhorse@localhost:5432/workhorse_test
WORKHORSE_BENCH_DATABASE_URL=postgres://workhorse:workhorse@localhost:5432/workhorse_bench
WORKHORSE_DEMO_DATABASE_URL=postgres://workhorse:workhorse@localhost:5432/workhorse_demo

# Portless uses a repository-specific unprivileged HTTP proxy, so development never needs sudo.
PORTLESS_PORT=43155
PORTLESS_HTTPS=0

# The observability demo exports OpenTelemetry traces and metrics to local SigNoz.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# `pnpm demo:otel` enables this for both demo processes.
WORKHORSE_DEMO_TELEMETRY=false
