# Repository-owned databases. Each linked worktree receives an isolated set.
DATABASE_URL_PRIMARY=postgres://workhorse:workhorse@localhost:5432/workhorse_dev_primary
DATABASE_URL_SECONDARY=postgres://workhorse:workhorse@localhost:5432/workhorse_dev_secondary
DATABASE_URL_TEST=postgres://workhorse:workhorse@localhost:5432/workhorse_test
DATABASE_URL_BENCH=postgres://workhorse:workhorse@localhost:5432/workhorse_bench
DATABASE_URL_TEST_PACKED=postgres://workhorse:workhorse@localhost:5432/workhorse_test_packed

# Portless uses a repository-specific unprivileged HTTP proxy, so development never needs sudo.
PORTLESS_PORT=43155
PORTLESS_HTTPS=0

# The observability demo exports OpenTelemetry traces and metrics to local SigNoz.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# `pnpm demo:otel` enables this for both demo processes.
WORKHORSE_DEMO_TELEMETRY=false
